{
  "name": "ripide-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "homepage": "https://github.com/harlan-zw/ripide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/ripide.git"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/ripide/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "bench": "tsx bench/bench.ts",
    "eval": "tsx evals/run.ts",
    "eval:check": "tsx evals/check.ts",
    "eval:projects": "tsx evals/projects.ts",
    "dev:prepare": "pnpm -r --filter './packages/*' run dev:prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --filter ripide-api exec tsc --noEmit --project ../../tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:package": "node --experimental-strip-types scripts/smoke-package.ts",
    "smoke:pnpm-package": "node --experimental-strip-types scripts/smoke-pnpm-package.ts",
    "release": "bumpp --recursive",
    "release:deprecate": "node --experimental-strip-types scripts/release.ts deprecate",
    "release:download": "node --experimental-strip-types scripts/release.ts download",
    "release:publish": "node --experimental-strip-types scripts/release.ts publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@babel/core": "^8.0.7",
    "@tsrx/content-mapper": "0.1.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "@vue/compiler-sfc": "^3.5.44",
    "babel-preset-solid": "^1.9.16",
    "bumpp": "^12.3.0",
    "citty": "^0.2.2",
    "eslint": "^10.13.0",
    "next": "^16.4.2",
    "obuild": "^0.4.45",
    "octane": "0.14.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ripide": "workspace:*",
    "ripide-api": "workspace:*",
    "ripide-tsrx": "workspace:*",
    "ripide-vue": "workspace:*",
    "solid-js": "^1.9.17",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.5",
    "vscode-uri": "^3.2.0"
  }
}
